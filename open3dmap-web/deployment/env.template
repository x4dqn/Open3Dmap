# Open3DMapWeb Environment Configuration
# Copy this file to .env and update the values for your environment

# ================================
# SERVER CONFIGURATION
# ================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ================================
# FIREBASE CONFIGURATION
# ================================
FIREBASE_PROJECT_ID=openarmap
FIREBASE_API_KEY=AIzaSyA7tIrr7LhTzWuDlYt2b5VWZ9PnI2Tjiow
FIREBASE_AUTH_DOMAIN=openarmap.firebaseapp.com
FIREBASE_STORAGE_BUCKET=openarmap.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=614313775038
FIREBASE_APP_ID=1:614313775038:web:de1f1b14412f5b1934b3ef
FIREBASE_MEASUREMENT_ID=G-NMV0S3C8PX

# Firebase Admin SDK (for server-side operations)
# Set this to the path of your service account key JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ================================
# COLMAP CONFIGURATION
# ================================
COLMAP_PATH=/usr/local/bin/colmap
PYTHON_PATH=/usr/bin/python3

# COLMAP processing settings
COLMAP_GPU_ENABLED=true
COLMAP_MAX_IMAGE_SIZE=2048
COLMAP_QUALITY=high

# Temporary directory for COLMAP processing
COLMAP_TEMP_DIR=/tmp/colmap-processing

# ================================
# SECURITY CONFIGURATION
# ================================
# CORS origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Session secret (generate a random string)
SESSION_SECRET=your-super-secret-session-key-change-this

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# DOMAIN AND SSL CONFIGURATION
# ================================
DOMAIN=yourdomain.com
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# ================================
# LOGGING CONFIGURATION
# ================================
LOG_LEVEL=info
LOG_DIR=/var/log/open3dmap
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14

# ================================
# PROCESSING CONFIGURATION
# ================================
# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=100

# Maximum number of images per scan
MAX_IMAGES_PER_SCAN=200

# Processing timeout (in seconds)
PROCESSING_TIMEOUT=3600

# ================================
# PERFORMANCE CONFIGURATION
# ================================
# Worker processes for CPU-intensive tasks
WORKER_PROCESSES=4

# Memory limits
MAX_MEMORY_USAGE=8192

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600

# ================================
# MONITORING CONFIGURATION
# ================================
# Health check endpoint
HEALTH_CHECK_ENABLED=true

# Metrics collection
METRICS_ENABLED=true

# Error reporting
ERROR_REPORTING_ENABLED=true

# ================================
# DEVELOPMENT CONFIGURATION
# ================================
# Debug mode (only for development)
DEBUG=false

# Hot reload (only for development)
HOT_RELOAD=false

# ================================
# BACKUP CONFIGURATION
# ================================
# Backup storage bucket
BACKUP_BUCKET=your-backup-bucket

# Backup retention (in days)
BACKUP_RETENTION_DAYS=30

# Automatic backup enabled
AUTO_BACKUP_ENABLED=true

# ================================
# EXTERNAL SERVICES
# ================================
# Google Cloud Storage
GCS_BUCKET=openarmap.firebasestorage.app

# Cloud Run service URL (if using)
CLOUD_RUN_URL=https://colmap-processor-614313775038.us-central1.run.app

# ================================
# CUSTOM CONFIGURATION
# ================================
# Add any custom environment variables here
# CUSTOM_VAR=value 