rules_version = '2';

// PRODUCTION VERSION - Firestore Security Rules for OpenARMap Scanner
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for authentication and validation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }
    
    function isValidUserData() {
      let data = request.resource.data;
      return data.keys().hasAll(['createdAt', 'email', 'firebaseUid']) &&
             data.firebaseUid == request.auth.uid &&
             isValidEmail(data.email) &&
             data.createdAt != null;
    }
    
    // Users collection
    match /users/{userId} {
      // Allow creating new user profiles
      allow create: if isAuthenticated() && 
                      request.auth.uid == userId &&
                      isValidUserData();
      
      // Users can read their own profile
      allow read: if isAuthenticated() && 
                     (request.auth.uid == userId ||
                      (resource != null && resource.data.firebaseUid == request.auth.uid));
      
      // Users can update their own profile (preserve core fields)
      allow update: if isAuthenticated() && 
                      resource != null &&
                      resource.data.firebaseUid == request.auth.uid &&
                      request.resource.data.firebaseUid == resource.data.firebaseUid &&
                      request.resource.data.email == resource.data.email &&
                      request.resource.data.createdAt == resource.data.createdAt;
      
      // Users can delete their own profile
      allow delete: if isAuthenticated() && 
                      resource != null &&
                      resource.data.firebaseUid == request.auth.uid;
    }
    
    // AR Scans collection - OpenARMap Scanner 3D scan data
    match /ar_scans/{scanId} {
      // Allow reading any scan for authenticated users (for web platform)
      allow read: if isAuthenticated();
      
      // Allow creating scans - exact same as debug rules that worked
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Allow updating own scans (preserve ownership)
      allow update: if isAuthenticated() && 
                      resource != null &&
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid;
      
      // Allow deleting own scans
      allow delete: if isAuthenticated() && 
                      resource != null &&
                      resource.data.userId == request.auth.uid;
      
      // Comments sub-collection within scans
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.keys().hasAll(['content', 'userId', 'createdAt']);
        allow update, delete: if isAuthenticated() && 
                                resource != null &&
                                resource.data.userId == request.auth.uid;
      }
      
      // Likes sub-collection within scans
      match /likes/{likeId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && 
                                likeId == request.auth.uid;
      }
    }
    
    // Public collections for app metadata
    match /app_settings/{document} {
      allow read: if true;
      allow write: if false; // Admin-only
    }
    
    // Collections for analytics and stats
    match /stats/{document} {
      allow read: if true;
      allow write: if false; // Use Cloud Functions
    }
    
    // Featured scans collection
    match /featured/{document} {
      allow read: if true;
      allow write: if false; // Admin-only
    }
    
    // User activity logs
    match /user_activity/{userId} {
      match /logs/{logId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false; // Logs are immutable
      }
    }
    
    // Test collection for development
    match /test/{document} {
      allow read, write: if isAuthenticated();
    }
    
    // Block access to any other collections not explicitly defined
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 